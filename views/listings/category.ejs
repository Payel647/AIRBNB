<% layout("/layouts/boilerplates") %>

<style>
    .category-page {
        padding: 2.5rem 0;
    }
    .category-title {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 1rem;
    }
    .category-section {
        max-width: 1200px;
        margin: auto;
        padding: 0 1rem;
    }
    .listing-card {
        border: none !important;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 14px 36px rgba(0, 0, 0, 0.08);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .listing-card:hover {
        transform: translateY(-4px) scale(1.01);
        box-shadow: 0 18px 44px rgba(0, 0, 0, 0.12);
    }
    .listing-card .card-body {
        padding: 1rem 0.75rem 1.25rem;
    }
    .listing-card .card-title {
        margin-bottom: 0;
        color: #222;
    }
    .listing-link {
        color: inherit;
        text-decoration: none;
    }
    .listing-link:hover {
        text-decoration: none;
    }
    .listing-count {
        font-size: 0.95rem;
        color: #666;
        text-align: center;
        margin-bottom: 1.5rem;
    }
    @media (max-width: 768px) {
        .col-md-4 {
            flex: 0 0 50%;
            max-width: 50%;
        }
    }
    @media (max-width: 480px) {
        .col-md-4 {
            flex: 0 0 100%;
            max-width: 100%;
        }
    }
</style>

<div class="category-page">
    <div class="category-section">
        <h2 class="category-title text-center">Listings for <%= category %></h2>
        <p class="listing-count"><%= listings.length %> stay<%= listings.length === 1 ? '' : 's' %> found in this category</p>

        <% if (listings.length > 0) { %>
            <div class="row gx-4 gy-4" id="listingItems">
                <% listings.forEach(listing => { %>
                    <div class="col-md-4">
                        <a href="/listings/<%= listing._id %>" class="listing-link">
                            <div class="card listing-card">
                                <img src="<%= listing.image.url || '/images/default.jpg' %>" class="card-img-top" alt="<%= listing.title %>" style="height: 240px; object-fit: cover;">
                                <div class="card-body text-center">
                                    <h5 class="card-title"><%= listing.title %></h5>
                                </div>
                            </div>
                        </a>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <h3 class="text-center text-danger mt-4">No listings are available in this category.</h3>
        <% } %>
    </div>
</div>